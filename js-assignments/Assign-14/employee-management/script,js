
"use strict";

// Employee class
class Employee {
    constructor(id, name, department, salary) {
        this.id = id;
        this.name = name;
        this.department = department;
        this.salary = salary;
    }

    // Calculate annual salary
    getAnnualSalary() {
        return this.salary * 12;
    }

    // Apply bonus
    applyBonus(percent) {
        this.salary += this.salary * percent / 100;
    }
}

// Create 5 employee objects
const employees = [
    new Employee(1, "Amit", "IT", 40000),
    new Employee(2, "Sara", "HR", 35000),
    new Employee(3, "Kiran", "Finance", 50000),
    new Employee(4, "Rahul", "IT", 45000),
    new Employee(5, "Priya", "Marketing", 30000)
];

// Apply 10% bonus to first employee
employees[0].applyBonus(10);

// Display employee details
console.log("Employee Details:");

employees.forEach(employee => {
    console.log(
        `ID: ${employee.id}, Name: ${employee.name}, Department: ${employee.department}, Annual Salary: ₹${employee.getAnnualSalary()}`
    );
});

// Calculate total annual payout using reduce()
const totalPayout = employees.reduce((total, employee) => {
    return total + employee.getAnnualSalary();
}, 0);

console.log("Total Annual Company Payout: ₹" + totalPayout);
